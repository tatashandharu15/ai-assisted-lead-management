{
  "name": "nodejs-ts-lead-mgmt",
  "version": "1.0.0",
  "description": "Lead Management System built with Node.js, TypeScript, and Fastify",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
